# ===========================================================================
#  JEU D'ESSAI — NE JAMAIS UTILISER EN PRODUCTION
# ===========================================================================
#
#  Toutes les valeurs ci-dessous sont FAUSSES. Elles servent a derouler le
#  parcours complet en local : panier, commande, RIB, declaration de virement,
#  back-office, confirmation.
#
#  Mode d'emploi :
#      cp .env.demo .env.local
#      npm run dev
#
#  `.env.local` est ignore par git ; ce fichier-ci ne l'est pas, et c'est
#  voulu : il ne contient aucun secret reel.
#
#  AVANT LA PREMIERE VENTE, remplacez TOUT par vos vraies valeurs. Le RIB
#  ci-dessous n'existe pas : un client qui virerait dessus perdrait son
#  argent. Le nom du beneficiaire crie « DEMONSTRATION » precisement pour que
#  l'erreur se voie a l'ecran.
# ===========================================================================


# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Un site d'essai n'a rien a faire dans Google.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Laisse a « true » : 12 fiches sur 15 sont encore inventees, et le bandeau
# qui le rappelle doit rester visible.
NEXT_PUBLIC_DEMO_CATALOG=true


# --- Identite de l'exploitant ----------------------------------------------
# Renseignee pour que /mentions-legales et /cgv s'affichent completes au lieu
# de leur avertissement. Entreprise imaginaire.
LEGAL_ENTITY=PELLORA DEMONSTRATION SAS
LEGAL_REGISTRATION=RCS Paris 000 000 000
LEGAL_ADDRESS=1 rue de l'Essai, 75000 Paris, France
LEGAL_FORM=SAS
LEGAL_CAPITAL=1 000 €
LEGAL_VAT_NUMBER=FR00000000000
LEGAL_DIRECTOR=Prenom Nom
LEGAL_HOST=Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, USA
LEGAL_MEDIATOR=Mediateur de la consommation (a souscrire), adresse, site

# --- Contact ----------------------------------------------------------------
SUPPORT_EMAIL=contact@exemple.invalid
ORDERS_EMAIL=commandes@exemple.invalid
SUPPORT_PHONE=+33 1 00 00 00 00

# --- Reseaux sociaux --------------------------------------------------------
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=


# --- Paiement par virement --------------------------------------------------
#
#  CE RIB N'EXISTE PAS.
#
#  L'IBAN contient le mot DEMONSTRATION en toutes lettres : aucun virement ne
#  peut aboutir, et la faute se voit au premier coup d'oeil sur la page de
#  commande comme dans l'e-mail client.
#
BANK_HOLDER=DEMONSTRATION — NE PAS VIRER
BANK_IBAN=FR76DEMONSTRATION0000000000
BANK_BIC=DEMOFRPPXXX
BANK_NAME=Banque de demonstration


# --- Back-office ------------------------------------------------------------
# Mot de passe d'essai, volontairement lisible. Douze caracteres minimum,
# sinon /admin reste ferme. A REGENERER avant toute mise en ligne :
#   openssl rand -base64 24
ADMIN_PASSWORD=essai-local-pellora-2026


# --- Persistance (Upstash Redis) --------------------------------------------
# LAISSE VIDE VOLONTAIREMENT. Sans ces variables, les commandes vivent en
# memoire : il n'y a rien a installer pour essayer, et le parcours fonctionne
# de bout en bout.
#
# Consequence a connaitre : les commandes disparaissent a chaque redemarrage
# de `npm run dev`. C'est pour cette raison que Redis est bloquant en
# production — une commande payee ne doit pas pouvoir se perdre.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- E-mails (SMTP) ---------------------------------------------------------
# LAISSE VIDE VOLONTAIREMENT. Sans serveur SMTP, aucun message ne part : ils
# s'affichent dans le terminal, prefixes [e-mail:simulation]. C'est la
# meilleure facon de relire l'e-mail client avec son RIB, sans ecrire a
# personne.
#
# Pour essayer un vrai envoi avec Gmail :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=votre.adresse@gmail.com
#   SMTP_PASSWORD=<mot de passe d'application : myaccount.google.com/apppasswords>
#   EMAIL_FROM=votre.adresse@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
EMAIL_FROM=Pellora (demo) <contact@exemple.invalid>

# Les alertes d'equipe s'affichent dans la console elles aussi : nouvelle
# commande, virement declare par le client.
OPS_ALERT_EMAIL=ops@exemple.invalid
