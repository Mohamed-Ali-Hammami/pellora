# ---------------------------------------------------------------------------
# Configuration de la boutique
#
# Copiez ce fichier vers .env.local et renseignez les valeurs.
# .env.local est ignore par git : il ne doit JAMAIS etre commite.
#
# La boutique demarre sans aucune de ces variables : le paiement est alors
# desactive, les e-mails partent en console et les commandes ne sont pas
# transmises. C'est volontaire — on peut tout parcourir sans risque.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# URL publique, sans slash final. Sert aux liens des e-mails et au sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laisser a « false » jusqu'au lancement reel : empeche l'indexation d'un site
# dont les mentions legales et les visuels ne sont pas finalises.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Passez a « false » UNIQUEMENT quand le catalogue contient les vraies donnees
# du fournisseur. Tant que cette variable n'est pas a « false », un bandeau
# rappelle sur chaque page que les fiches techniques sont fictives.
NEXT_PUBLIC_DEMO_CATALOG=true


# --- Identite de l'exploitant (mentions legales, CGV) -----------------------
# OBLIGATOIRE avant la premiere vente. L'absence de ces mentions est
# sanctionnee en France (art. 6 III LCEN) et dans l'UE (directive 2011/83/UE).
# Les pages /mentions-legales et /cgv affichent un avertissement visible tant
# que ces trois premieres variables ne sont pas renseignees.
LEGAL_ENTITY=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_VAT_NUMBER=
LEGAL_DIRECTOR=
# Hebergeur : nom, adresse et telephone. Valeur par defaut : Vercel.
LEGAL_HOST=
# Mediateur de la consommation — obligatoire en France (art. L.612-1 code de
# la consommation) : nom, adresse postale et site du mediateur.
LEGAL_MEDIATOR=

# --- Contact affiche sur le site -------------------------------------------
SUPPORT_EMAIL=
ORDERS_EMAIL=
SUPPORT_PHONE=

# --- Reseaux sociaux (optionnel) -------------------------------------------
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=


# --- Paiement (Stripe) ------------------------------------------------------
# Cles depuis dashboard.stripe.com/apikeys. Utilisez les cles de TEST
# (sk_test_...) tant que vous n'avez pas valide tout le parcours.
STRIPE_SECRET_KEY=

# Secret du webhook, obtenu en creant un point de terminaison vers
#   https://votre-domaine/api/webhooks/stripe
# avec les evenements : checkout.session.completed, checkout.session.expired,
# charge.refunded, charge.dispute.created
# En local : stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=


# --- Persistance (Upstash Redis) --------------------------------------------
# OBLIGATOIRE en production. Sans ces variables, les commandes sont stockees
# en memoire et disparaissent a chaque redemarrage : le suivi client ne
# fonctionne pas et une commande payee peut etre perdue.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- E-mails transactionnels (Resend) ---------------------------------------
RESEND_API_KEY=
# Doit utiliser un domaine verifie dans Resend, sinon les messages partent en spam.
EMAIL_FROM=Pellora <contact@votre-domaine.fr>
# Adresse qui recoit les alertes d'incident (echec de transmission, litige).
OPS_ALERT_EMAIL=


# --- Fournisseur : option A, API REST ---------------------------------------
# Si votre grossiste expose une API, renseignez ces deux variables.
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
# En-tete portant la cle, si ce n'est pas « Authorization: Bearer ».
SUPPLIER_AUTH_HEADER=

# --- Fournisseur : option B, bon de commande par e-mail ---------------------
# Utilise uniquement si SUPPLIER_API_URL est vide. Beaucoup de grossistes
# europeens fonctionnent ainsi, et ce sont souvent les plus rapides.
SUPPLIER_ORDER_EMAIL=
# Copie cachee vers votre propre boite, pour la tracabilite.
SUPPLIER_ORDER_BCC=
# Grossiste conduits / accessoires, si distinct du grossiste appareils.
FLUES_ORDER_EMAIL=
# Fournisseur de granules.
PELLETS_ORDER_EMAIL=

# Secret partage pour /api/webhooks/supplier, par lequel le fournisseur
# renvoie les numeros de suivi. Generez-le avec :
#   openssl rand -hex 32
SUPPLIER_WEBHOOK_SECRET=


# --- Tache planifiee --------------------------------------------------------
# Protege /api/cron/reconcile, qui reessaie les commandes en echec.
# Sur Vercel, definissez la meme valeur dans les variables du projet.
#   openssl rand -hex 32
CRON_SECRET=
